# 에디터마다 다른 기본값(들여쓰기, 줄바꿈 등)을 통일한다.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust 공식 스타일(rustfmt)은 4칸 들여쓰기
[*.rs]
indent_size = 4

# 마크다운은 줄 끝 공백 두 칸이 줄바꿈 의미를 가질 수 있어서 유지
[*.md]
trim_trailing_whitespace = false
